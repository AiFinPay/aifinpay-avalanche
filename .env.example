# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.

# Deployer private key (0x-prefixed). Used only for `deploy`/`verify`.
# Keep this in a secret manager; do not paste a mainnet key into a shared machine.
PRIVATE_KEY=

# Avalanche C-Chain RPC. Defaults to the public endpoint if unset.
AVALANCHE_RPC=https://api.avax.network/ext/bc/C/rpc
